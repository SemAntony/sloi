{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client", "node"],
    "baseUrl": "../../../..",
    "paths": {
      "@sloi/ui-kit": ["src/shared/ui/index.ts"],
      "@sloi/headless-core": ["packages/headless-core/src/index.ts"],
      "@sloi/lit-wrappers": ["packages/lit-wrappers/src/index.ts"]
    }
  },
  "include": ["consumer.ts"]
}
