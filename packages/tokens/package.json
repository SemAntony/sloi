    "./css/colors.css": "./src/colors.css",
    "./css/tokens.css": "./src/tokens.css",
    "./css/typography.css": "./src/typography.css"
  },
  "scripts": {
    "sync": "node ./scripts/sync-artifacts.mjs"
  }
}
