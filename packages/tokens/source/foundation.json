{
  "space": {
    "0": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "5": {
      "$type": "dimension",
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "10": {
      "$type": "dimension",
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "12": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    }
  },
  "size": {
    "control": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 2.5,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      }
    },
    "size": {
      "100": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "200": {
        "$type": "dimension",
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "300": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "400": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "500": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "600": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "700": {
        "$type": "dimension",
        "$value": {
          "value": 1.875,
          "unit": "rem"
        }
      },
      "800": {
        "$type": "dimension",
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "label": {
        "$value": "{font.size.200}"
      }
    },
    "line": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "snug": {
        "$type": "number",
        "$value": 1.35
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.65
      },
      "label": {
        "$value": "{font.line.tight}"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "xs": {
        "$type": "duration",
        "$value": {
          "value": 110,
          "unit": "ms"
        }
      },
      "sm": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "md": {
        "$type": "duration",
        "$value": {
          "value": 140,
          "unit": "ms"
        }
      },
      "lg": {
        "$type": "duration",
        "$value": {
          "value": 160,
          "unit": "ms"
        }
      },
      "xl": {
        "$type": "duration",
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "2xl": {
        "$type": "duration",
        "$value": {
          "value": 220,
          "unit": "ms"
        }
      },
      "3xl": {
        "$type": "duration",
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ],
        "$extensions": {
          "sloi.css": "ease"
        }
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.58,
          1
        ],
        "$extensions": {
          "sloi.css": "ease-out"
        }
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.42,
          0,
          1,
          1
        ],
        "$extensions": {
          "sloi.css": "ease-in"
        }
      }
    }
  }
}
