{
  "name": "@sloi/ui-kit",
  "version": "1.1.0-rc.0",
  "description": "Sloi UI kit component library",
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./date-picker": {
      "import": {
        "types": "./dist/date-picker.d.ts",
        "default": "./dist/date-picker.js"
      },
      "require": {
        "types": "./dist/date-picker.d.cts",
        "default": "./dist/date-picker.cjs"
      }
    },
    "./data-table-v2": {
      "import": {
        "types": "./dist/data-table-v2.d.ts",
        "default": "./dist/data-table-v2.js"
      },
      "require": {
        "types": "./dist/data-table-v2.d.cts",
        "default": "./dist/data-table-v2.cjs"
      }
    },
    "./styles.css": "./dist/style.css",
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.mjs && node scripts/verify-exports.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:stories-a11y": "vitest run --config vitest.stories-a11y.config.ts",
    "mf:validate": "pnpm run build && node --experimental-strip-types scripts/multi-framework-readiness.ts --out reports/multi-framework/latest.json",
    "tokens:build": "pnpm --filter @sloi/tokens run build",
    "adoption:metrics": "node --experimental-strip-types scripts/adoption-metrics.ts",
    "adoption:metrics:ci": "node --experimental-strip-types scripts/adoption-metrics.ts --out reports/adoption/latest.json --consumers consumers/sloi-pilot consumers/sloi-analytics consumers/sloi-operations",
    "clean": "rm -rf dist",
    "tokens:contrast": "pnpm --filter @sloi/tokens run contrast",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@sloi/headless-core": "workspace:*",
    "@sloi/lit-wrappers": "workspace:*",
    "@sloi/tokens": "workspace:*",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "storybook": "^10.6.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
