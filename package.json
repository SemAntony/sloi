{
  "name": "@sloi/ui-kit",
  "version": "1.0.0",
  "description": "Sloi UI kit component library",
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "mf:validate": "pnpm run build && node --experimental-strip-types scripts/multi-framework-readiness.ts --out reports/multi-framework/latest.json",
    "tokens:sync": "pnpm --filter @sloi/tokens run sync",
    "adoption:metrics": "node --experimental-strip-types scripts/adoption-metrics.ts",
    "adoption:metrics:ci": "node --experimental-strip-types scripts/adoption-metrics.ts --out reports/adoption/latest.json --consumers consumers/sloi-pilot consumers/sloi-analytics consumers/sloi-operations",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@sloi/headless-core": "workspace:*",
    "@sloi/lit-wrappers": "workspace:*",
    "@sloi/tokens": "workspace:*",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "clsx": "^2.1.1",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "jsdom": "^22.1.0",
    "react": "^19.1.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.1",
    "sass": "^1.89.2",
    "storybook": "^8.6.18",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^5.4.14",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
